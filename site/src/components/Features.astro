---
import Section from "./Section.astro";
import { features } from "../data/features";
---

<Section
  eyebrow="Capabilities"
  title="A harness, not a prompt."
  lead="The guarantees live in code, the judgment lives in the model, and the whole thing is built to be measured."
>
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {
      features.map((feature) => (
        <article class="flex flex-col rounded-xl border border-border bg-surface p-6">
          <p class="font-mono text-xs tracking-[0.2em] text-accent-text uppercase">
            {feature.tag}
          </p>
          <h3 class="mt-3 text-lg font-semibold">{feature.title}</h3>
          <p class="mt-3 text-sm text-muted">{feature.body}</p>
        </article>
      ))
    }
  </div>
</Section>