---
import GenieMark from "./GenieMark.astro";
import { site, links } from "../data/site";
import { withBase } from "../utils/url";

const items = [
  { href: links.install, label: "Install" },
  { href: links.howItWorks, label: "How it works" },
  { href: links.githubAction, label: "GitHub Action" },
];
---

<header
  class="sticky top-0 z-50 border-b border-border/70 bg-bg/80 backdrop-blur-md"
>
  <nav
    class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between px-6"
    aria-label="Primary"
  >
    <a
      href={withBase("")}
      class="flex items-center gap-2.5 rounded-md font-semibold tracking-tight"
      aria-label={`${site.name} home`}
    >
      <GenieMark size={32} />
      <span>codegenie</span>
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <ul class="hidden items-center gap-1 md:flex">
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                class="rounded-md px-3 py-2 text-sm text-muted transition-colors hover:text-text"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a
        href={site.repo}
        class="rounded-md px-3 py-2 text-sm text-muted transition-colors hover:text-text"
        rel="noopener noreferrer"
        target="_blank"
      >
        GitHub <span aria-hidden="true">↗</span>
      </a>
      <a
        href={site.npmUrl}
        class="hidden rounded-md px-3 py-2 text-sm text-muted transition-colors hover:text-text sm:inline-block"
        rel="noopener noreferrer"
        target="_blank"
      >
        npm <span aria-hidden="true">↗</span>
      </a>
    </div>
  </nav>
</header>