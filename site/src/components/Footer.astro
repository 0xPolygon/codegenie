---
import GenieMark from "./GenieMark.astro";
import { site, links, polygonUrl } from "../data/site";

const columns = [
  {
    heading: "Project",
    items: [
      { label: "GitHub", href: site.repo, external: true },
      { label: "npm", href: site.npmUrl, external: true },
      { label: "Supported models", href: links.models, external: true },
    ],
  },
  {
    heading: "Docs",
    items: [
      { label: "Example workflows", href: links.workflows, external: true },
      { label: "MIT License", href: links.license, external: true },
    ],
  },
  {
    heading: "On this page",
    items: [
      { label: "Install", href: links.install, external: false },
      { label: "How it works", href: links.howItWorks, external: false },
      { label: "GitHub Action", href: links.githubAction, external: false },
    ],
  },
];
---

<footer class="border-t border-border">
  <div class="mx-auto w-full max-w-6xl px-6 py-14">
    <div class="grid gap-10 md:grid-cols-[minmax(0,1.5fr)_repeat(3,minmax(0,1fr))]">
      <div>
        <div class="flex items-center gap-2.5 font-semibold tracking-tight">
          <GenieMark size={32} />
          <span>codegenie</span>
        </div>
        <p class="mt-3 max-w-xs text-sm text-muted">
          Open source under the {site.license} license. Pre-1.0, being hardened
          through live evals.
        </p>
      </div>

      {
        columns.map((column) => (
          <nav aria-label={column.heading}>
            <h2 class="font-mono text-xs tracking-[0.2em] text-muted uppercase">
              {column.heading}
            </h2>
            <ul class="mt-4 space-y-2">
              {column.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="text-sm text-muted transition-colors hover:text-text"
                    {...(item.external
                      ? { rel: "noopener noreferrer", target: "_blank" }
                      : {})}
                  >
                    {item.label}
                    {item.external && <span aria-hidden="true"> ↗</span>}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-border pt-6 text-sm text-faint sm:flex-row sm:items-center sm:justify-between"
    >
      <p>
        Built by{" "}
        <a
          href={polygonUrl}
          class="text-muted underline decoration-border underline-offset-4 hover:text-text"
          rel="noopener noreferrer"
          target="_blank">Polygon</a
        >
      </p>
      <p class="font-mono text-xs">
        {site.actionRef.split("@")[0]}@{site.actionRef.split("@")[1]}
      </p>
    </div>
  </div>
</footer>