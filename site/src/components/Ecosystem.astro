---
import Section from "./Section.astro";
import { languages, providers, providerOverflow, links } from "../data/site";
---

<Section
  eyebrow="Ecosystem"
  title="Your languages. Your model provider."
  lead="First-class syntax context for six languages, and any model you already pay for."
>
  <div class="grid gap-10 md:grid-cols-2">
    <div>
      <h3 class="font-mono text-xs tracking-[0.2em] text-muted uppercase">
        First-class syntax context
      </h3>
      <ul class="mt-4 flex flex-wrap gap-2">
        {
          languages.map((lang) => (
            <li class="rounded-full border border-border bg-surface px-3.5 py-1.5 text-sm text-text">
              {lang}
            </li>
          ))
        }
      </ul>
      <p class="mt-4 text-sm text-faint">
        Plus a <code class="text-muted">lang/javascript</code> lane with its own
        runtime-semantics guidance.
      </p>
    </div>

    <div>
      <h3 class="font-mono text-xs tracking-[0.2em] text-muted uppercase">
        Works with
      </h3>
      <ul class="mt-4 flex flex-wrap gap-2">
        {
          providers.map((provider) => (
            <li class="rounded-full border border-border bg-surface px-3.5 py-1.5 text-sm text-muted">
              {provider}
            </li>
          ))
        }
        <li class="rounded-full border border-accent/40 px-3.5 py-1.5 text-sm text-accent-text">
          {providerOverflow}
        </li>
      </ul>
      <p class="mt-4 text-sm text-faint">
        The full list of models, context windows, and reasoning levels lives in{" "}
        <a
          href={links.models}
          class="text-accent-text underline decoration-accent/40 underline-offset-4 hover:decoration-accent"
          rel="noopener noreferrer"
          target="_blank"
        >
          models.md
        </a>.
      </p>
    </div>
  </div>
</Section>