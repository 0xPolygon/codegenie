---
import { Code } from "astro:components";

/** Languages actually used on this page; all are Shiki bundled languages. */
type CodeLang = "bash" | "yaml" | "json" | "markdown";

interface Props {
  code: string;
  lang?: CodeLang;
  filename?: string;
  /** Compact rows (single command) skip the header bar. */
  compact?: boolean;
  class?: string;
}

const {
  code,
  lang = "bash",
  filename,
  compact = false,
  class: className = "",
} = Astro.props;

const hasHeader = Boolean(filename) && !compact;
const trimmed = code.replace(/\n$/, "");
---

<div
  class:list={[
    "group relative overflow-hidden rounded-xl border border-border bg-surface",
    className,
  ]}
>
  {
    hasHeader && (
      <div class="flex items-center justify-between gap-4 border-b border-border bg-surface-2 px-4 py-2">
        <span class="truncate font-mono text-xs text-muted">{filename}</span>
        <button
          type="button"
          class="cg-copy shrink-0 rounded-md border border-border px-2 py-1 font-mono text-xs text-muted transition-colors hover:border-border-strong hover:text-text"
          data-copy={trimmed}
          hidden
          aria-label={`Copy ${filename} to clipboard`}
        >
          Copy
        </button>
      </div>
    )
  }

  <div class:list={["relative", compact && "pr-12"]}>
    <div class="overflow-x-auto p-4 text-sm leading-relaxed">
      <Code code={trimmed} lang={lang} theme="github-dark-default" />
    </div>

    {
      !hasHeader && (
        <button
          type="button"
          class="cg-copy absolute top-2 right-2 rounded-md border border-border bg-bg/80 px-2 py-1 font-mono text-xs text-muted backdrop-blur transition-colors hover:border-border-strong hover:text-text"
          data-copy={trimmed}
          hidden
          aria-label="Copy to clipboard"
        >
          Copy
        </button>
      )
    }
  </div>
</div>