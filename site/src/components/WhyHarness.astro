---
import Section from "./Section.astro";

const cards = [
  {
    title: "Coverage honesty",
    body: "Every hunk gets a decision or a disclosed skip reason. An autonomous agent cannot tell you what it didn't look at.",
  },
  {
    title: "Independent verification",
    body: "Verifiers never see the reviewer's reasoning, so they can't anchor on it.",
  },
  {
    title: "Diagnosable quality",
    body: "An end-to-end agent tells you that it missed; a staged harness tells you why.",
  },
];
---

<Section
  eyebrow="Why a harness"
  title="It is not a chatbot pointed at a diff."
  lead="A fully autonomous agent is one decision point making hundreds of unauditable micro-decisions. codegenie is a staged pipeline where deterministic code owns the guarantees — coverage, anchoring, verification, dedup, budgets, telemetry — and LLM agents do the judgment work inside each stage."
>
  <div class="grid gap-6 md:grid-cols-3">
    {
      cards.map((card) => (
        <div class="rounded-xl border border-border bg-surface p-6">
          <h3 class="text-lg font-semibold">{card.title}</h3>
          <p class="mt-3 text-sm text-muted">{card.body}</p>
        </div>
      ))
    }
  </div>

  <blockquote
    class="mt-10 border-l-2 border-accent pl-6 text-xl font-medium tracking-tight text-text"
  >
    Judgment in the model, invariants in the harness.
  </blockquote>
</Section>