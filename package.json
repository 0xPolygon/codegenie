{
  "name": "codeninja",
  "version": "0.1.0",
  "description": "High-signal AI code review for pull requests.",
  "type": "module",
  "bin": {
    "codeninja": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "bundled-skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli/main.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "commander": "15.0.0",
    "smol-toml": "1.6.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
