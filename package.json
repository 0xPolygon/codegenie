{
  "name": "@0xsequence/codegenie",
  "version": "0.7.0",
  "description": "High-signal AI code review agent",
  "type": "module",
  "bin": {
    "codegenie": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "bundled-skills",
    "bundled-grammars",
    "models.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/write-version.mjs && node scripts/copy-grammars.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:workflows": "bash scripts/check-workflows.sh",
    "check": "pnpm run typecheck && pnpm run check:workflows",
    "test": "pnpm run check:workflows && vitest run",
    "test:watch": "vitest",
    "models-list": "node scripts/write-models-md.mjs",
    "dev": "tsx src/cli/main.ts",
    "publish-release": "pnpm login && pnpm publish --access public --no-git-checks"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "dependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "commander": "15.0.0",
    "execa": "10.1.1",
    "p-limit": "7.3.3",
    "picomatch": "4.0.7",
    "smol-toml": "1.9.1",
    "web-tree-sitter": "0.27.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/picomatch": "4.0.3",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-rust": "0.24.0",
    "tree-sitter-solidity": "1.2.13",
    "tree-sitter-typescript": "0.23.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
