{
  "name": "@0xsequence/codegenie",
  "version": "0.3.0",
  "description": "High-signal AI code review agent",
  "type": "module",
  "bin": {
    "codegenie": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "bundled-skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/write-version.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli/main.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "dependencies": {
    "@earendil-works/pi-ai": "0.80.3",
    "@vscode/ripgrep": "1.18.0",
    "commander": "15.0.0",
    "execa": "9.6.1",
    "p-limit": "7.3.0",
    "picomatch": "4.0.4",
    "smol-toml": "1.7.0",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-typescript": "0.23.2",
    "web-tree-sitter": "0.26.10",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.0.1",
    "@types/picomatch": "4.0.3",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
